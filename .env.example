# Copy to .env and fill in
# Name this machine shows up as in dashboards and alerts
HOST_NAME=home-server

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Alerts go to Telegram: create a bot with @BotFather, message it once, then set these
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_CHAT_ID=123456789

# Optional: an app's Postgres, read by the collector's postgresql receiver
APP_NETWORK=app_default
POSTGRES_DATABASE=app
POSTGRES_MONITOR_USER=monitor
POSTGRES_MONITOR_PASSWORD=change-me

# AdGuard Home API (Settings > General: any admin user works)
ADGUARD_URL=http://192.168.1.2
ADGUARD_USER=admin
ADGUARD_PASSWORD=change-me

# Router admin login (router-exporter currently supports Netgear Orbi)
ROUTER_HOST=192.168.1.1
ROUTER_USER=admin
ROUTER_PASSWORD=change-me

METRICS_RETENTION=30d
