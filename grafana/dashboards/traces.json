{
  "uid": "traces",
  "title": "Traces",
  "tags": [
    "home",
    "traces"
  ],
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_span_metrics_calls, service_name)",
          "refId": "service"
        },
        "definition": "label_values(traces_span_metrics_calls, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "title": "Home Overview",
      "type": "link",
      "url": "/d/home-overview"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "nodeGraph",
      "title": "Service map",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 12
      },
      "description": "Calls between services (and to databases / external hosts) over the selected time range, from the collector's servicegraph connector. Needs client spans: a service only shows an edge to the thing it calls when it records the outgoing call.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spans / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 7,
        "h": 6
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error spans %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 7,
        "h": 6
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls{service_name=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))\n/ sum by (service_name) (rate(traces_span_metrics_calls{service_name=~\"$service\"}[$__rate_interval])) * 100",
          "legendFormat": "{{service_name}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latency by operation (dots = example traces, click to open)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 6,
        "w": 14,
        "h": 6
      },
      "description": "Each dot is a real request (an exemplar). Hover and click the trace ID to open it.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name, span_name) (rate(traces_span_metrics_duration_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} {{span_name}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 10
      },
      "description": "Latest traces. Click a trace ID to show it in the trace view below.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:pipe}\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show this trace below",
                    "url": "/d/traces/traces?${service:queryparam}&var-traceId=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Slow traces (> 500 ms)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 10
      },
      "description": "Traces that took longer than half a second end to end.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:pipe}\" && traceDuration > 500ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show this trace below",
                    "url": "/d/traces/traces?${service:queryparam}&var-traceId=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Traces with errors",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 10
      },
      "description": "Traces where any span recorded an error.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:pipe}\" && status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show this trace below",
                    "url": "/d/traces/traces?${service:queryparam}&var-traceId=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "traces",
      "title": "Trace view: $traceId",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 16
      },
      "description": "Pick a trace by clicking a trace ID in one of the tables above, or paste one into the Trace ID box at the top.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "$traceId"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Logs mentioning this trace",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "description": "Log lines that contain the trace ID. Apps need to include the trace ID in their logs (OpenTelemetry logging does this automatically).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\".+\"} |= \"$traceId\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      }
    }
  ]
}
